  <bpmn:collaboration id="Collaboration_UserDoctorPatient">
    <bpmn:participant id="Pool_Patient" name="Patient" processRef="Process_Patient" />
    <bpmn:participant id="Pool_Doctor" name="Doctor" processRef="Process_Doctor" />
    <bpmn:participant id="Pool_Admin" name="Administrator" processRef="Process_Admin" />
    <bpmn:messageFlow id="Msg_01" name="new doctor account" sourceRef="D_CreateAccount" targetRef="A_Start" />
    <bpmn:messageFlow id="Msg_02" name="verified / rejected" sourceRef="A_End" targetRef="D_Result" />
    <bpmn:messageFlow id="Msg_03" name="X-ray" sourceRef="P_Share" targetRef="D_Shared" />
    <bpmn:messageFlow id="Msg_04" name="comment" sourceRef="D_Comment" targetRef="P_Comment" />
    <bpmn:messageFlow id="Msg_05" name="request" sourceRef="P_Request" targetRef="D_Requested" />
    <bpmn:messageFlow id="Msg_06" name="confirmed / cancelled" sourceRef="D_Answer" targetRef="P_Answer" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Patient" name="Patient" isExecutable="false">
    <bpmn:userTask id="P_Upload" name="Upload X-ray">
      <bpmn:incoming>Flow_1qfijr0</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="P_Share" name="Share X-ray with doctor">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="P_Comment" name="Doctor comment received">
