      <bpmn:outgoing>Flow_05</bpmn:outgoing>
      <bpmn:messageEventDefinition id="P_Comment_Def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="P_Start" targetRef="P_HasAccount" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Activity_1387si9" targetRef="Gateway_0h9g2v0" />
