      <bpmn:outgoing>Flow_1a6mieq</bpmn:outgoing>
      <bpmn:outgoing>Flow_1ud71k2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:startEvent id="P_Start" name="Needs a consultation">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P_CreateAccount" name="Create patient account">
