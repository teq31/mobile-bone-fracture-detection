<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_XRayAnalysis" targetNamespace="http://bonefracture.com/bpmn" exporter="Hand-written" exporterVersion="1.0">
  <bpmn:error id="Error_Model" name="ModelError" errorCode="MODEL_ERROR" />
  <bpmn:collaboration id="Collaboration_XRayAnalysis">
    <bpmn:participant id="Participant_App" name="X-ray Analysis (Mobile Bone Fracture Detection)" processRef="Process_XRayAnalysis" />
    <bpmn:participant id="Participant_FCM" name="Firebase Cloud Messaging" />
    <bpmn:messageFlow id="MessageFlow_Notify" name="ANALYSIS_FINISHED" sourceRef="Task_Notify" targetRef="Participant_FCM" />
  </bpmn:collaboration>
  <bpmn:process id="Process_XRayAnalysis" name="X-ray Analysis" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_User" name="User (Student / Doctor / Patient)">
        <bpmn:flowNodeRef>Start_Analyze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_MergeSource</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Source</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Upload</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Photo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_MergeAdded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ChooseAnother</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Reviewed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_App" name="Mobile App">
        <bpmn:flowNodeRef>Task_Convert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Preprocess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Role</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ModelError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Threshold</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Show</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Patient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Disclaimer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_MergeDisclaimer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ForkReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SaveLocal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Online</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Online</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_MergeOnline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Sync</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Models" name="Detection Models">
        <bpmn:flowNodeRef>Task_MainModel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Yolo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RfDetr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Consensus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_MergeModels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Heatmaps</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_ModelError</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Backend" name="Backend API">
        <bpmn:flowNodeRef>Task_Store</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Done</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Analyze" name="X-ray to analyze">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gw_MergeSource">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_Source" name="How is the X-ray added?">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Upload" name="Upload file (JPG / PNG / PDF)">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Photo" name="Take a photo with the camera">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_MergeAdded">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Convert" name="Convert source to XRayImage">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Assoc_Task_Convert_Data_XRayImage"><bpmn:targetRef>Data_XRayImage</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:subProcess id="Sub_Validate" name="Validate image" triggeredByEvent="false">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Assoc_Sub_Validate_Data_Validation"><bpmn:targetRef>Data_Validation</bpmn:targetRef></bpmn:dataOutputAssociation>
      <bpmn:startEvent id="Sub_Start">
        <bpmn:outgoing>SubFlow_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="Sub_FileType" name="Check file type (JPG / PNG / PDF)">
        <bpmn:incoming>SubFlow_1</bpmn:incoming>
        <bpmn:outgoing>SubFlow_2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Sub_FileSize" name="Check file size">
        <bpmn:incoming>SubFlow_2</bpmn:incoming>
        <bpmn:outgoing>SubFlow_3</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Sub_LooksLike" name="Check it looks like an X-ray">
        <bpmn:incoming>SubFlow_3</bpmn:incoming>
        <bpmn:outgoing>SubFlow_4</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="Sub_End" name="ValidationReport created">
        <bpmn:incoming>SubFlow_4</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SubFlow_1" sourceRef="Sub_Start" targetRef="Sub_FileType" />
      <bpmn:sequenceFlow id="SubFlow_2" sourceRef="Sub_FileType" targetRef="Sub_FileSize" />
      <bpmn:sequenceFlow id="SubFlow_3" sourceRef="Sub_FileSize" targetRef="Sub_LooksLike" />
      <bpmn:sequenceFlow id="SubFlow_4" sourceRef="Sub_LooksLike" targetRef="Sub_End" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="Gw_Valid" name="Image valid?">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ChooseAnother" name="See failed checks, choose another image">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Preprocess" name="Preprocess image (resize, normalize)">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Role" name="User role?">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_MainModel" name="Run main model (YOLO)">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gw_Fork">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_Yolo" name="Run YOLO model">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_RfDetr" name="Run RF-DETR model">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gw_Join">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_Consensus" name="Build ConsensusView">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_MergeModels">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Heatmaps" name="Generate heatmaps (EigenCAM)">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Assoc_Task_Heatmaps_Data_Result"><bpmn:targetRef>Data_Result</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:task id="Task_ModelError" name="Show analysis error">
      <bpmn:incoming>Flow_42</bpmn:incoming>
      <bpmn:outgoing>Flow_43</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Error" name="Analysis failed">
      <bpmn:incoming>Flow_43</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrDef_End" errorRef="Error_Model" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_Threshold" name="Filter detections by confidence threshold">
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="Task_Show" name="Show boxes, scores and heatmap">
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_Patient" name="Patient?">
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Disclaimer" name="Show medical disclaimer">
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_MergeDisclaimer">
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:incoming>Flow_29</bpmn:incoming>
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gw_ForkReview">
      <bpmn:incoming>Flow_30</bpmn:incoming>
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
      <bpmn:outgoing>Flow_33</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Task_Review" name="Review result (zoom, show / hide boxes)">
      <bpmn:incoming>Flow_31</bpmn:incoming>
      <bpmn:outgoing>Flow_32</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Reviewed" name="Result reviewed">
      <bpmn:incoming>Flow_32</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_SaveLocal" name="Save analysis to history (local)">
      <bpmn:incoming>Flow_33</bpmn:incoming>
      <bpmn:outgoing>Flow_34</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Assoc_Task_SaveLocal_Store_Local"><bpmn:targetRef>Store_Local</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Online" name="Internet available?">
      <bpmn:incoming>Flow_34</bpmn:incoming>
      <bpmn:outgoing>Flow_35</bpmn:outgoing>
      <bpmn:outgoing>Flow_36</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Event_Online" name="Connection restored">
      <bpmn:incoming>Flow_36</bpmn:incoming>
      <bpmn:outgoing>Flow_37</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="CondDef_Online"><bpmn:condition xsi:type="bpmn:tFormalExpression">internet connection available</bpmn:condition></bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_MergeOnline">
      <bpmn:incoming>Flow_35</bpmn:incoming>
      <bpmn:incoming>Flow_37</bpmn:incoming>
      <bpmn:outgoing>Flow_38</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Sync" name="Sync analysis to the backend">
      <bpmn:incoming>Flow_38</bpmn:incoming>
      <bpmn:outgoing>Flow_39</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="Task_Store" name="Store X-ray and analysis">
      <bpmn:incoming>Flow_39</bpmn:incoming>
      <bpmn:outgoing>Flow_40</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Assoc_Task_Store_Store_Server"><bpmn:targetRef>Store_Server</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_Notify" name="Send push notification">
      <bpmn:incoming>Flow_40</bpmn:incoming>
      <bpmn:outgoing>Flow_41</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_Done" name="Analysis saved">
      <bpmn:incoming>Flow_41</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObject id="Data_XRayImage_Obj" />
    <bpmn:dataObjectReference id="Data_XRayImage" name="XRayImage" dataObjectRef="Data_XRayImage_Obj" />
    <bpmn:dataObject id="Data_Validation_Obj" />
    <bpmn:dataObjectReference id="Data_Validation" name="ValidationReport" dataObjectRef="Data_Validation_Obj" />
    <bpmn:dataObject id="Data_Result_Obj" />
    <bpmn:dataObjectReference id="Data_Result" name="AnalysisResult" dataObjectRef="Data_Result_Obj" />
    <bpmn:dataStoreReference id="Store_Local" name="Local database (SQLite)" />
    <bpmn:dataStoreReference id="Store_Server" name="Database (PostgreSQL)" />
    <bpmn:boundaryEvent id="Boundary_ModelError" name="Model error" attachedToRef="Task_MainModel">
      <bpmn:outgoing>Flow_42</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrDef_Boundary" errorRef="Error_Model" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_Analyze" targetRef="Gw_MergeSource" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Gw_MergeSource" targetRef="Gw_Source" />
    <bpmn:sequenceFlow id="Flow_03" name="File" sourceRef="Gw_Source" targetRef="Task_Upload" />
    <bpmn:sequenceFlow id="Flow_04" name="Camera" sourceRef="Gw_Source" targetRef="Task_Photo" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_Upload" targetRef="Gw_MergeAdded" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_Photo" targetRef="Gw_MergeAdded" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Gw_MergeAdded" targetRef="Task_Convert" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_Convert" targetRef="Sub_Validate" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Sub_Validate" targetRef="Gw_Valid" />
    <bpmn:sequenceFlow id="Flow_10" name="Yes" sourceRef="Gw_Valid" targetRef="Task_Preprocess" />
    <bpmn:sequenceFlow id="Flow_11" name="No" sourceRef="Gw_Valid" targetRef="Task_ChooseAnother" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_ChooseAnother" targetRef="Gw_MergeSource" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_Preprocess" targetRef="Gw_Role" />
    <bpmn:sequenceFlow id="Flow_14" name="Student / Patient" sourceRef="Gw_Role" targetRef="Task_MainModel" />
    <bpmn:sequenceFlow id="Flow_15" name="Doctor" sourceRef="Gw_Role" targetRef="Gw_Fork" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Gw_Fork" targetRef="Task_Yolo" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Gw_Fork" targetRef="Task_RfDetr" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_Yolo" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_RfDetr" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Gw_Join" targetRef="Task_Consensus" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_MainModel" targetRef="Gw_MergeModels" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_Consensus" targetRef="Gw_MergeModels" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Gw_MergeModels" targetRef="Task_Heatmaps" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_Heatmaps" targetRef="Task_Threshold" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_Threshold" targetRef="Task_Show" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Task_Show" targetRef="Gw_Patient" />
    <bpmn:sequenceFlow id="Flow_27" name="Yes" sourceRef="Gw_Patient" targetRef="Task_Disclaimer" />
    <bpmn:sequenceFlow id="Flow_28" name="No" sourceRef="Gw_Patient" targetRef="Gw_MergeDisclaimer" />
    <bpmn:sequenceFlow id="Flow_29" sourceRef="Task_Disclaimer" targetRef="Gw_MergeDisclaimer" />
    <bpmn:sequenceFlow id="Flow_30" sourceRef="Gw_MergeDisclaimer" targetRef="Gw_ForkReview" />
    <bpmn:sequenceFlow id="Flow_31" sourceRef="Gw_ForkReview" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="Flow_32" sourceRef="Task_Review" targetRef="End_Reviewed" />
    <bpmn:sequenceFlow id="Flow_33" sourceRef="Gw_ForkReview" targetRef="Task_SaveLocal" />
    <bpmn:sequenceFlow id="Flow_34" sourceRef="Task_SaveLocal" targetRef="Gw_Online" />
    <bpmn:sequenceFlow id="Flow_35" name="Yes" sourceRef="Gw_Online" targetRef="Gw_MergeOnline" />
    <bpmn:sequenceFlow id="Flow_36" name="No" sourceRef="Gw_Online" targetRef="Event_Online" />
    <bpmn:sequenceFlow id="Flow_37" sourceRef="Event_Online" targetRef="Gw_MergeOnline" />
    <bpmn:sequenceFlow id="Flow_38" sourceRef="Gw_MergeOnline" targetRef="Task_Sync" />
    <bpmn:sequenceFlow id="Flow_39" sourceRef="Task_Sync" targetRef="Task_Store" />
    <bpmn:sequenceFlow id="Flow_40" sourceRef="Task_Store" targetRef="Task_Notify" />
    <bpmn:sequenceFlow id="Flow_41" sourceRef="Task_Notify" targetRef="End_Done" />
    <bpmn:sequenceFlow id="Flow_42" sourceRef="Boundary_ModelError" targetRef="Task_ModelError" />
    <bpmn:sequenceFlow id="Flow_43" sourceRef="Task_ModelError" targetRef="End_Error" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_XRayAnalysis">
    <bpmndi:BPMNPlane id="Plane_XRayAnalysis" bpmnElement="Collaboration_XRayAnalysis">
      <bpmndi:BPMNShape id="Participant_App_di" bpmnElement="Participant_App" isHorizontal="true"><dc:Bounds x="40" y="40" width="4595" height="1060" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_User_di" bpmnElement="Lane_User" isHorizontal="true"><dc:Bounds x="70" y="40" width="4565" height="240" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_App_di" bpmnElement="Lane_App" isHorizontal="true"><dc:Bounds x="70" y="280" width="4565" height="240" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Models_di" bpmnElement="Lane_Models" isHorizontal="true"><dc:Bounds x="70" y="520" width="4565" height="360" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Backend_di" bpmnElement="Lane_Backend" isHorizontal="true"><dc:Bounds x="70" y="880" width="4565" height="220" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Analyze_di" bpmnElement="Start_Analyze"><dc:Bounds x="157" y="142" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="127" y="183" width="96" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_MergeSource_di" bpmnElement="Gw_MergeSource"><dc:Bounds x="300" y="135" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Source_di" bpmnElement="Gw_Source"><dc:Bounds x="450" y="135" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="338" y="109" width="105" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Upload_di" bpmnElement="Task_Upload"><dc:Bounds x="570" y="65" width="110" height="80" /></bpmndi:BPMNShape>
