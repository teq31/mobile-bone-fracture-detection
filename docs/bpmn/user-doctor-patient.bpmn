<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_UserDoctorPatient" targetNamespace="http://bonefracture.com/bpmn">
  <bpmn:collaboration id="Collaboration_UserDoctorPatient">
    <bpmn:participant id="Pool_Patient" name="Patient" processRef="Process_Patient" />
    <bpmn:participant id="Pool_Doctor" name="Doctor" processRef="Process_Doctor" />
    <bpmn:participant id="Pool_Admin" name="Administrator" processRef="Process_Admin" />
    <bpmn:messageFlow id="Msg_01" name="new doctor account" sourceRef="D_CreateAccount" targetRef="A_Start" />
    <bpmn:messageFlow id="Msg_02" name="verified / rejected" sourceRef="A_End" targetRef="D_Result" />
    <bpmn:messageFlow id="Msg_03" name="X-ray" sourceRef="P_Share" targetRef="D_Shared" />
    <bpmn:messageFlow id="Msg_04" name="comment" sourceRef="D_Comment" targetRef="P_Comment" />
    <bpmn:messageFlow id="Msg_05" name="request" sourceRef="P_Request" targetRef="D_Requested" />
    <bpmn:messageFlow id="Msg_06" name="confirmed / cancelled" sourceRef="D_Answer" targetRef="P_Answer" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Patient" name="Patient" isExecutable="false">
    <bpmn:startEvent id="P_Start" name="Needs a consultation">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P_CreateAccount" name="Create patient account">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P_Upload" name="Upload X-ray">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="P_Share" name="Share X-ray with doctor">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="P_Comment" name="Doctor comment received">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
      <bpmn:messageEventDefinition id="P_Comment_Def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="P_Request" name="Request appointment">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="P_Answer" name="Answer received">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
      <bpmn:messageEventDefinition id="P_Answer_Def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="P_Confirmed" name="Confirmed?">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="P_End" name="Appointment scheduled">
      <bpmn:incoming>Flow_08</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="P_EndNo" name="No appointment">
      <bpmn:incoming>Flow_09</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="P_Start" targetRef="P_CreateAccount" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="P_CreateAccount" targetRef="P_Upload" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="P_Upload" targetRef="P_Share" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="P_Share" targetRef="P_Comment" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="P_Comment" targetRef="P_Request" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="P_Request" targetRef="P_Answer" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="P_Answer" targetRef="P_Confirmed" />
    <bpmn:sequenceFlow id="Flow_08" name="Yes" sourceRef="P_Confirmed" targetRef="P_End" />
    <bpmn:sequenceFlow id="Flow_09" name="No" sourceRef="P_Confirmed" targetRef="P_EndNo" />
  </bpmn:process>
  <bpmn:process id="Process_Doctor" name="Doctor" isExecutable="false">
    <bpmn:startEvent id="D_Start" name="Wants to use the app">
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="D_CreateAccount" name="Create doctor account">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="D_Result" name="Verification result received">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:messageEventDefinition id="D_Result_Def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="D_Verified" name="Account verified?">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="D_EndNotVerified" name="Account not verified">
      <bpmn:incoming>Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="D_Shared" name="X-ray shared">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:messageEventDefinition id="D_Shared_Def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="D_Comment" name="Review X-ray and comment">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="D_Requested" name="Appointment requested">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:messageEventDefinition id="D_Requested_Def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="D_Answer" name="Confirm or cancel appointment">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="D_End" name="Request answered">
      <bpmn:incoming>Flow_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="D_Start" targetRef="D_CreateAccount" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="D_CreateAccount" targetRef="D_Result" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="D_Result" targetRef="D_Verified" />
    <bpmn:sequenceFlow id="Flow_13" name="Yes" sourceRef="D_Verified" targetRef="D_Shared" />
    <bpmn:sequenceFlow id="Flow_14" name="No" sourceRef="D_Verified" targetRef="D_EndNotVerified" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="D_Shared" targetRef="D_Comment" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="D_Comment" targetRef="D_Requested" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="D_Requested" targetRef="D_Answer" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="D_Answer" targetRef="D_End" />
  </bpmn:process>
  <bpmn:process id="Process_Admin" name="Administrator" isExecutable="false">
    <bpmn:startEvent id="A_Start" name="New doctor account">
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
      <bpmn:messageEventDefinition id="A_Start_Def" />
    </bpmn:startEvent>
    <bpmn:userTask id="A_Verify" name="Verify doctor account">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="A_End" name="Result sent">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:messageEventDefinition id="A_End_Def" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="A_Start" targetRef="A_Verify" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="A_Verify" targetRef="A_End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_UserDoctorPatient">
    <bpmndi:BPMNPlane id="Plane_UserDoctorPatient" bpmnElement="Collaboration_UserDoctorPatient">
      <bpmndi:BPMNShape id="Pool_Patient_di" bpmnElement="Pool_Patient" isHorizontal="true"><dc:Bounds x="150" y="40" width="1420" height="230" /></bpmndi:BPMNShape>
