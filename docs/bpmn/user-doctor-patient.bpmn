      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="248" y="400" /><di:waypoint x="305" y="400" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11"><di:waypoint x="405" y="400" /><di:waypoint x="587" y="400" /></bpmndi:BPMNEdge>
