# Copy to .env and fill in. Do not commit the real .env.

# Database
DB_NAME=bonefracture
DB_USERNAME=bonefracture
DB_PASSWORD=change-me

# Backend
BACKEND_PORT=8080

# JWT signing secret (at least 32 characters)
JWT_SECRET=change-me-to-a-long-random-secret-0123456789

# First administrator account (created at startup if both are set)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin
